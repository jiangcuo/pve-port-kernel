From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jiangcuo@bingsin.com
Date: Mon, 30 Sep 2024 12:00:00 +0000
Subject: [PATCH] zfs: Add support for openEuler's struct shrinker_v2 interface

The openEuler kernel uses KABI (Kernel Application Binary Interface)
compatibility mechanism to maintain binary compatibility while updating
kernel interfaces. As part of this mechanism, the super_block->s_shrink
field has been changed from 'struct shrinker' to 'struct shrinker_v2 *'
in openEuler kernels.

This change causes ZFS compilation to fail with the error:
"None of the expected sb->s_shrink() interfaces were detected"

This patch adds support for the openEuler-specific shrinker_v2 interface
while maintaining compatibility with standard upstream kernel interfaces.

Changes include:
1. Add configure detection for struct shrinker_v2 interface in 
   config/kernel-shrink.m4
2. Add conditional compilation support in zfs_vfsops.c to handle both
   standard shrinker and shrinker_v2 interfaces
3. Add proper header inclusion for shrinker_v2 when available

The patch maintains full backward compatibility with standard kernel
shrinker interfaces and only activates the shrinker_v2 code path when
HAVE_SUPER_BLOCK_S_SHRINK_V2 is defined by the configure script.

This resolves ZFS compilation issues on openEuler-based kernels while
ensuring no impact on other kernel distributions.

Signed-off-by: jiangcuo@bingsin.com
---
 config/kernel-shrink.m4            | 30 +++++++++++++++++++++++++++++-
 module/os/linux/zfs/zfs_vfsops.c  | 31 +++++++++++++++++++++++++++++--
 2 files changed, 58 insertions(+), 3 deletions(-)

diff --git a/config/kernel-shrink.m4 b/config/kernel-shrink.m4
index c4258f4..5c5c4cc 100644
--- a/config/kernel-shrink.m4
+++ b/config/kernel-shrink.m4
@@ -37,6 +37,28 @@ AC_DEFUN([ZFS_AC_KERNEL_SRC_SUPER_BLOCK_S_SHRINK_PTR], [
 	],[])
 ])
 
+dnl #
+dnl # openEuler specific change
+dnl # s_shrink is now a pointer to struct shrinker_v2.
+dnl #
+AC_DEFUN([ZFS_AC_KERNEL_SRC_SUPER_BLOCK_S_SHRINK_V2], [
+	ZFS_LINUX_TEST_SRC([super_block_s_shrink_v2], [
+		#include <linux/fs.h>
+		#include <linux/shrinker.h>
+		static unsigned long shrinker_v2_cb(struct shrinker_v2 *shrink,
+		    struct shrink_control *sc) { return 0; }
+		static struct shrinker_v2 shrinker_v2 = {
+			.count_objects = shrinker_v2_cb,
+			.scan_objects = shrinker_v2_cb,
+			.seeks = DEFAULT_SEEKS,
+		};
+		static const struct super_block
+		    sb __attribute__ ((unused)) = {
+			.s_shrink = &shrinker_v2,
+		};
+	],[])
+])
+
 AC_DEFUN([ZFS_AC_KERNEL_SUPER_BLOCK_S_SHRINK], [
 	AC_MSG_CHECKING([whether super_block has s_shrink])
 	ZFS_LINUX_TEST_RESULT([super_block_s_shrink], [
@@ -52,7 +74,15 @@ AC_DEFUN([ZFS_AC_KERNEL_SUPER_BLOCK_S_SHRINK], [
 				[have super_block s_shrink pointer])
 		],[
 			AC_MSG_RESULT(no)
-			ZFS_LINUX_TEST_ERROR([sb->s_shrink()])
+			AC_MSG_CHECKING([whether super_block has s_shrink v2 pointer])
+			ZFS_LINUX_TEST_RESULT([super_block_s_shrink_v2], [
+				AC_MSG_RESULT(yes)
+				AC_DEFINE(HAVE_SUPER_BLOCK_S_SHRINK_V2, 1,
+					[have super_block s_shrink v2 pointer])
+			],[
+				AC_MSG_RESULT(no)
+				ZFS_LINUX_TEST_ERROR([sb->s_shrink()])
+			])
 		])
 	])
 ])
@@ -120,6 +150,7 @@ AC_DEFUN([ZFS_AC_KERNEL_SHRINKER_REGISTER], [
 AC_DEFUN([ZFS_AC_KERNEL_SRC_SHRINKER], [
 	ZFS_AC_KERNEL_SRC_SUPER_BLOCK_S_SHRINK
 	ZFS_AC_KERNEL_SRC_SUPER_BLOCK_S_SHRINK_PTR
+	ZFS_AC_KERNEL_SRC_SUPER_BLOCK_S_SHRINK_V2
 	ZFS_AC_KERNEL_SRC_REGISTER_SHRINKER_VARARG
 	ZFS_AC_KERNEL_SRC_SHRINKER_REGISTER
 ])
diff --git a/module/os/linux/zfs/zfs_vfsops.c b/module/os/linux/zfs/zfs_vfsops.c
index 7961549..92acf1c 100644
--- a/module/os/linux/zfs/zfs_vfsops.c
+++ b/module/os/linux/zfs/zfs_vfsops.c
@@ -62,6 +62,9 @@
 #include <sys/zpl.h>
 #include <linux/vfs_compat.h>
 #include <linux/fs.h>
+#ifdef HAVE_SUPER_BLOCK_S_SHRINK_V2
+#include <linux/shrinker.h>
+#endif
 #include "zfs_comutil.h"
 
 enum {
@@ -1242,6 +1245,8 @@ zfs_prune_aliases(zfsvfs_t *zfsvfs, unsigned long nr_to_scan)
 #define	S_SHRINK(sb)	(&(sb)->s_shrink)
 #elif defined(HAVE_SUPER_BLOCK_S_SHRINK_PTR)
 #define	S_SHRINK(sb)	((sb)->s_shrink)
+#elif defined(HAVE_SUPER_BLOCK_S_SHRINK_V2)
+#define	S_SHRINK(sb)	((sb)->s_shrink)
 #endif
 
 int
@@ -1249,7 +1254,6 @@ zfs_prune(struct super_block *sb, unsigned long nr_to_scan, int *objects)
 {
 	zfsvfs_t *zfsvfs = sb->s_fs_info;
 	int error = 0;
-	struct shrinker *shrinker = S_SHRINK(sb);
 	struct shrink_control sc = {
 		.nr_to_scan = nr_to_scan,
 		.gfp_mask = GFP_KERNEL,
@@ -1258,6 +1262,8 @@ zfs_prune(struct super_block *sb, unsigned long nr_to_scan, int *objects)
 	if ((error = zfs_enter(zfsvfs, FTAG)) != 0)
 		return (error);
 
+#if defined(HAVE_SUPER_BLOCK_S_SHRINK_V2)
+	struct shrinker_v2 *shrinker = S_SHRINK(sb);
 #ifdef SHRINKER_NUMA_AWARE
 	if (shrinker->flags & SHRINKER_NUMA_AWARE) {
 		long tc = 1;
@@ -1282,6 +1288,34 @@ zfs_prune(struct super_block *sb, unsigned long nr_to_scan, int *objects)
 	}
 #else
 	*objects = (*shrinker->scan_objects)(shrinker, &sc);
+#endif
+#else
+	struct shrinker *shrinker = S_SHRINK(sb);
+#ifdef SHRINKER_NUMA_AWARE
+	if (shrinker->flags & SHRINKER_NUMA_AWARE) {
+		long tc = 1;
+		for_each_online_node(sc.nid) {
+			long c = shrinker->count_objects(shrinker, &sc);
+			if (c  == 0 || c == SHRINK_EMPTY)
+				continue;
+			tc += c;
+		}
+		*objects = 0;
+		for_each_online_node(sc.nid) {
+			long c = shrinker->count_objects(shrinker, &sc);
+			if (c  == 0 || c == SHRINK_EMPTY)
+				continue;
+			if (c > tc)
+				tc = c;
+			sc.nr_to_scan = mult_frac(nr_to_scan, c, tc) + 1;
+			*objects += (*shrinker->scan_objects)(shrinker, &sc);
+		}
+	} else {
+			*objects = (*shrinker->scan_objects)(shrinker, &sc);
+	}
+#else
+	*objects = (*shrinker->scan_objects)(shrinker, &sc);
+#endif
 #endif
 
 	/*