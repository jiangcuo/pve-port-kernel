CONFIG_LOONGARCH_IOMMU=m
CONFIG_ARCH_IOREMAP=y
CONFIG_CPU_HAS_LBT=y
CONFIG_NR_CPUS=1024
CONFIG_LOONGSON3_ACPI_CPUFREQ=y
CONFIG_CRYPTO_CRC32_LOONGARCH=y

### keep consistent with amd64/arm64
CONFIG_NO_HZ_FULL=y
CONFIG_VIRT_CPU_ACCOUNTING_GEN=y
CONFIG_LRU_GEN=y
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_SYSFS=y
CONFIG_DAMON_RECLAIM=y
CONFIG_DAMON_LRU_SORT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_IOMMUFD=m

### BTF: pahole crashes on loongarch build, keep off for now
CONFIG_DEBUG_INFO_BTF=n
CONFIG_DEBUG_INFO_BTF_MODULES=n

### loong64 only: onboard / soc NIC drivers
# cortina
CONFIG_GEMINI_ETHERNET=m
# ezchip
CONFIG_EZCHIP_NPS_MANAGEMENT_ENET=m
# litex
CONFIG_LITEX_LITEETH=m
