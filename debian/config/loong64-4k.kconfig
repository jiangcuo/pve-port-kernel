# loongarch64 4k page size variant config
# Default is 16KB_3LEVEL, override to 4KB with 3 levels
CONFIG_4KB_3LEVEL=y
# CONFIG_16KB_2LEVEL is not set
# CONFIG_16KB_3LEVEL is not set
CONFIG_LOONGARCH_IOMMU=m
CONFIG_ARCH_IOREMAP=y
CONFIG_CPU_HAS_LBT=y
CONFIG_NR_CPUS=256
CONFIG_LOONGSON3_ACPI_CPUFREQ=y
CONFIG_CRYPTO_CRC32_LOONGARCH=y