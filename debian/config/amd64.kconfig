CONFIG_KVM=m
CONFIG_HSA_AMD=y
CONFIG_INTEL_MEI_TXE=m
CONFIG_INTEL_MEI_GSC=m
CONFIG_SATA_NV=m

### vfio / iommu
CONFIG_VFIO_PCI_VGA=y
CONFIG_VFIO_PCI_IGD=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y

### nested: x86-only guest drivers
CONFIG_PTP_1588_CLOCK_VMW=m
CONFIG_VBOXGUEST=m
CONFIG_DRM_VBOXVIDEO=m
CONFIG_XEN_PVH=y

### amd64 only: SCSI / RAID drivers
# scsi
CONFIG_SCSI_ISCI=m
