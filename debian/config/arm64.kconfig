CONFIG_ARCH_K3=y
CONFIG_ARCH_SPARX5=y 
CONFIG_ARCH_EXYNOS=y
CONFIG_ARCH_TESLA_FSD=y
CONFIG_ARCH_ALPINE=y


# ARCH
CONFIG_HISI_VIRTCCA_GUEST=n
CONFIG_KVM_HISI_VIRT=n
CONFIG_HISI_VIRTCCA_HOST=n 

### pmu
#### fix kunpeng920 rcu error
CONFIG_HISI_PMU=n

### mailbox

CONFIG_BCM_FLEXRM_MBOX=n

### iommu
CONFIG_IOMMU_IO_PGTABLE_ARMV7S=y

### Andriod
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y


### watchdog
CONFIG_SDEI_WATCHDOG=n
CONFIG_ARM_SDE_INTERFACE=n


### phytium
CONFIG_DRM_PHYTIUM=n


### Drivers
CONFIG_DWMAC_INTEL_PLAT=m
CONFIG_DWMAC_TEGRA=m
CONFIG_DWMAC_MEDIATEK=m
CONFIG_SH_ETH=m
CONFIG_RAVB=m
CONFIG_RENESAS_ETHER_SWITCH=m
