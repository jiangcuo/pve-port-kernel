CONFIG_NET_MEDIATEK_STAR_EMA=y
CONFIG_MVNETA=m
CONFIG_MVPP2=m 
CONFIG_FEC=m 
CONFIG_FSL_FMAN=m 
CONFIG_FSL_PQ_MDIO=m 
CONFIG_FSL_XGMAC_MDIO=m 
