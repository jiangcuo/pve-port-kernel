# Platform selection
CONFIG_ARCH_ACTIONS=y
CONFIG_ARCH_SUNXI=y
CONFIG_ARCH_APPLE=y
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_ARCH_BCM_IPROC=y
CONFIG_ARCH_BCMBCA=y
CONFIG_ARCH_BRCMSTB=y
CONFIG_ARCH_NXP=y
CONFIG_ARCH_LAYERSCAPE=y
CONFIG_ARCH_MXC=y
CONFIG_ARCH_S32=y
CONFIG_ARCH_MESON=y
CONFIG_ARCH_RENESAS=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARCH_TEGRA=y
CONFIG_ARCH_INTEL_SOCFPGA=y
CONFIG_ARCH_MVEBU=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARCH_KEEMBAY=y
CONFIG_ARCH_K3=y
CONFIG_ARCH_SPARX5=y 
CONFIG_ARCH_EXYNOS=y
CONFIG_ARCH_TESLA_FSD=y
CONFIG_ARCH_ALPINE=y


# ARCH
CONFIG_HISI_VIRTCCA_GUEST=n
CONFIG_KVM_HISI_VIRT=n
CONFIG_HISI_VIRTCCA_HOST=n 

### pmu
#### fix kunpeng920 rcu error
CONFIG_HISI_PMU=n

### mailbox

CONFIG_BCM_FLEXRM_MBOX=n

### iommu
CONFIG_IOMMU_IO_PGTABLE_ARMV7S=y

### Andriod
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y


### watchdog
CONFIG_SDEI_WATCHDOG=n
CONFIG_ARM_SDE_INTERFACE=n


### phytium
CONFIG_DRM_PHYTIUM=n


### Drivers
CONFIG_DWMAC_INTEL_PLAT=m
CONFIG_NET_MEDIATEK_SOC=y 
CONFIG_NET_MEDIATEK_STAR_EMA=y
CONFIG_FSL_DPAA2_SWITCH=m 
CONFIG_DRM_KMB_DISPLAY=m
CONFIG_HSA_AMD=y
CONFIG_DRM_TEGR=m 
CONFIG_DRM_V3D=m 
CONFIG_DRM_HISI_KIRIN=m 
CONFIG_DRM_MESON=m
CONFIG_DRM_PANFROST=m 
CONFIG_DRM_LIMA=m 
CONFIG_DRM_EXYNOS=m 

## iommu 
CONFIG_ROCKCHIP_IOMMU=y 
CONFIG_SUN50I_IOMMU=y 
CONFIG_EXYNOS_IOMMU=y 
CONFIG_MTK_IOMMU=m 
CONFIG_QCOM_IOMMU=y
CONFIG_TEGRA_IOMMU_SMMU=y
CONFIG_ARM_SMMU_V3_PM=y 

## Cryptographic API
CONFIG_CRYPTO_SM3_NEON=m
CONFIG_CRYPTO_SM3_ARM64_CE=m
CONFIG_CRYPTO_SM4_ARM64_CE_CCM=m 
CONFIG_CRYPTO_SM4_ARM64_CE_GCM=m 
CONFIG_CRYPTO_DEV_AMLOGIC_GXL=m 

CONFIG_CRYPTO_DEV_FSL_CAAM=m 
CONFIG_CRYPTO_DEV_EXYNOS_RNG=m 
CONFIG_CRYPTO_DEV_ATMEL_ECC=m 
CONFIG_CRYPTO_DEV_ATMEL_SHA204A=m 
CONFIG_CRYPTO_DEV_KEEMBAY_OCS_AES_SM4=m 
CONFIG_CRYPTO_DEV_KEEMBAY_OCS_AES_SM4_ECB=y 
CONFIG_CRYPTO_DEV_KEEMBAY_OCS_AES_SM4_CTS=y 
CONFIG_CRYPTO_DEV_KEEMBAY_OCS_ECC=m 
CONFIG_CRYPTO_DEV_KEEMBAY_OCS_HCU=m 
CONFIG_CRYPTO_DEV_KEEMBAY_OCS_HCU_HMAC_SHA224=y 
CONFIG_CRYPTO_DEV_QCE=m 
CONFIG_CRYPTO_DEV_QCOM_RNG=m 
CONFIG_CRYPTO_DEV_ROCKCHIP=m 

### server platforms
CONFIG_PCIE_HISI_ERR=y
CONFIG_ARM_CMN=m
CONFIG_ARM_DMC620_PMU=m
CONFIG_ARM_CORESIGHT_PMU_ARCH_SYSTEM_PMU=m

### nested: xen guest on arm64
CONFIG_XEN=y

### security
CONFIG_ARM64_BTI=y

### arm64 only: onboard / soc NIC drivers
